table Measure
	lineageTag: ee043dba-09e1-4e36-a6f9-adf830c440c2

	measure 'Last Available Trading Price' = ```
			
			CALCULATE(
			    LASTNONBLANK('btcusd_1-min_data'[Close], 1),
			    ENDOFYEAR(dimCalendar[Date])
			)
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: defa26b8-9563-4e80-a5a6-38c0f320b8a5

	measure 'Yearly Bitcoin Top Direct' =
			
			CALCULATE(
			    MAX('btcusd_1-min_data'[High]),
			    ALLEXCEPT(dimCalendar, dimCalendar[Year])
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 34961270-6f17-4ed7-885f-545d90c663d8

	measure 'Daily Closing Price' = ```
			
			CALCULATE(
			    MAX('btcusd_1-min_data'[Close]),
			    LASTDATE(dimCalendar[Date])
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c576a025-8a77-40b2-9bd7-e3a705ac06b3

	column Measures
		dataType: int64
		formatString: 0
		lineageTag: b4d09f5a-6786-4ed0-aa1e-d2c6bdd1577d
		summarizeBy: sum
		sourceColumn: Measures

		annotation SummarizationSetBy = Automatic

	partition Measure = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measures = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Measures", Int64.Type}})
				in
				    #"Changed Type"

	changedProperty = Name

	annotation PBI_ResultType = Table

